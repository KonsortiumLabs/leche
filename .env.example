# Node 24+. Run: node --env-file=.env src/server.mjs
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
# Set to your actual HTTPS origin before public deployment. No trailing slash.
# SITE_URL=https://your-confirmed-domain.example
# Set only behind a trusted proxy that OVERWRITES X-Forwarded-For.
TRUST_PROXY=false
# Optional read-only admin API. Generate with: openssl rand -hex 32
# ADMIN_TOKEN=
